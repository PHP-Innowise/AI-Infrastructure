        ".cursor": {
          "transform": "copy",
          "replacements": [
            [
              ".claude/",
              ".cursor/"
            ]
          ]
        },
        ".codex": {
          "transform": "copy",
          "replacements": [
            [
              ".claude/skills/",
              ".agents/skills/"
