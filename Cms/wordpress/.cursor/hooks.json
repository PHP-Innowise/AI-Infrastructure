{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor local-context --root .",
        "timeout": 15
      },
      {
        "command": "memory-bank/bin/infra-engine hook cursor context-continuity --root .",
        "timeout": 8
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor working-memory-read --root .",
        "timeout": 10
      },
      {
        "command": "memory-bank/bin/infra-engine hook cursor context-continuity --root .",
        "timeout": 8
      }
    ],
    "subagentStart": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor subagent-gate --root .",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor subagent-dispatch --root .",
        "timeout": 8
      }
    ],
    "beforeShellExecution": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor bash-validator --root .",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor file-naming-validator --root .",
        "timeout": 5
      },
      {
        "command": "memory-bank/bin/infra-engine hook cursor loop-detection --root .",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor context-continuity --root .",
        "timeout": 8
      }
    ],
    "stop": [
      {
        "command": "memory-bank/bin/infra-engine hook cursor working-memory-write --root .",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
