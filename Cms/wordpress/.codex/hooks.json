{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/local-context.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/context-continuity.sh restore",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/working-memory-read.sh",
            "additionalContextLimit": 4000
          },
          {
            "type": "command",
            "command": ".codex/hooks/context-continuity.sh capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/working-memory-write.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/context-continuity.sh capture"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/bash-validator.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/file-naming-validator.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/subagent-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/loop-detection.sh"
          }
        ]
      }
    ]
  }
}
