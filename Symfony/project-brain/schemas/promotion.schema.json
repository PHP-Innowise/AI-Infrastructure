{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "status", "revision", "proposer", "reviewer",
    "review_mode", "reviewed_at", "created_at", "updated_at", "source_records",
    "title", "content", "destination_memory_id", "destination_revision",
    "conflicts", "outcome"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["proposed", "reviewed", "rejected", "applied"]},
    "revision": {"type": "integer", "minimum": 1},
    "proposer": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"]},
    "review_mode": {"enum": ["human", "automatic"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "revision"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "type": {"enum": ["task", "finding", "bug", "incident", "decision", "event"]},
          "path": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "destination_memory_id": {"type": ["string", "null"]},
    "destination_revision": {"type": ["integer", "null"], "minimum": 1},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outcome": {"type": ["string", "null"]}
  }
}
