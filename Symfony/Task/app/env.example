# PracticePerfect environment template.
#
#   make setup      (copies this file to .env, which is git-ignored)
#
# NOTE ON THE FILENAME: the brief asks for `.env.example`. This repository's
# own .claude/settings.json denies Write(.env.*), which matches that name, so
# the template is committed as `env.example` instead. Relax that deny rule if
# you want the conventional dot-prefixed name.
#
# Never commit real credentials. The database passwords below are throwaway
# values for the local Compose stack only: the database is not published
# outside the Compose network except on a local port, and these roles exist
# only inside a disposable volume. Stripe keys are deliberately blank.

COMPOSE_PROJECT_NAME=practiceperfect

# --- Host user -------------------------------------------------------------
# Files written inside the containers are owned by this uid/gid on the host.
UID=1000
GID=1000

# --- Host port bindings ----------------------------------------------------
HTTP_PORT=8080
MAIL_UI_PORT=8125
DB_PORT=15433

# --- PostgreSQL roles ------------------------------------------------------
# Three roles, because Row-Level Security is the fifth tenancy layer:
#   owner    — DDL and migrations only, never the running application
#   app      — the running application; RLS applies to it
#   crossing — read-only, BYPASSRLS, cross-tenant projections only
POSTGRES_DB=practiceperfect
POSTGRES_OWNER_USER=pp_owner
POSTGRES_OWNER_PASSWORD=owner_dev_only
APP_DB_USER=pp_app
APP_DB_PASSWORD=app_dev_only
CROSSING_DB_USER=pp_crossing
CROSSING_DB_PASSWORD=crossing_dev_only
DB_HOST=db
DB_PORT_INTERNAL=5432

# --- Symfony ---------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
# Regenerate for any non-local use: openssl rand -hex 16
APP_SECRET=6f3c1d2b9a7e4c508d1f2a3b4c5d6e7f

# NOTE: DATABASE_URL, MIGRATION_DATABASE_URL, CROSSING_DATABASE_URL, MAILER_DSN
# and MESSENGER_TRANSPORT_DSN are deliberately NOT set here. compose.yaml
# composes them from the role credentials above, so "which role does the
# application connect as" is decided in exactly one place. Setting them here
# would have no effect: Compose `environment` beats `env_file`, and Symfony's
# Dotenv never overrides a real environment variable.
#
# A consequence worth knowing: if a Flex recipe appends its own DATABASE_URL to
# your .env, it is ignored rather than silently pointing the app at the wrong
# database. Run `make env-reset` to get a clean .env back.
#
# The other side of that trade: `make env-reset` also discards any variable a
# recipe added. When `composer require` installs a bundle that appends a new
# variable to .env, mirror it here (or into compose.yaml's x-app-environment if
# its value is a property of the stack rather than of the operator's machine),
# or the next reset will take it away and the app will fail to boot with
# "Environment variable not found".

# --- Stripe ----------------------------------------------------------------
# Test keys only. Leave blank until Epic-05. Never commit a real key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
