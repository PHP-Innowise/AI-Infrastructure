{% extends 'base.html.twig' %}

{% block title %}Forgot password — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <h1>Forgot your password?</h1>
        <p>Enter your email and, if it matches an account, we'll send a reset link.</p>

        {{ form_start(form) }}
            {{ form_widget(form) }}
        {{ form_end(form) }}

        <p><a href="{{ path('identity_auth_login') }}">Back to sign in</a></p>
    </div>
{% endblock %}
