{% extends 'base.html.twig' %}

{% block title %}{{ roleLabel }} dashboard — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <p class="skeleton-eyebrow">{{ roleLabel }}</p>
        <h1>Welcome, {{ account.profile ? account.profile.firstName : account.email }}</h1>

        <p>You are signed in as <strong>{{ account.email }}</strong>.</p>

        {% if not account.emailVerified %}
            <p class="skeleton-caption">
                Your email address is not verified.
                <form method="post" action="{{ path('identity_email_verify_resend') }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('email-verify-resend') }}">
                    <button type="submit">Resend verification email</button>
                </form>
            </p>
        {% endif %}

        <h2>Tenant context</h2>
        {% if activeTrainerId %}
            <p>Active trainer: <code>#{{ activeTrainerId }}</code>. Trainer-scoped
               data is readable only within this tenant.</p>
        {% else %}
            <p>No tenant resolved. Trainer-scoped data is unreachable — for a
               Super Admin this is deliberate, because no role hierarchy grants
               ownership implicitly.</p>
        {% endif %}

        {% if trainerLinks %}
            <h2>Your trainers</h2>
            {# Separated per trainer, never combined: owner decision A6 and
               BR-01-10. This list is the switcher, not a merged view. #}
            <ul>
                {% for link in trainerLinks %}
                    <li>
                        {{ link.trainer.businessName }} — {{ link.roleInTenant }}
                        {% if trainerLinks|length > 1 %}
                            <form method="post" action="{{ path('platform_context_trainer_switch', {trainer: link.trainer.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('trainer-context' ~ link.trainer.id) }}">
                                <button type="submit">Switch to this trainer</button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {#
            The product's only navigation. Grouped by what the user is trying to
            do rather than by which epic built it — an epic boundary is an
            implementation detail nobody signing in cares about.

            Feature-gated groups are omitted entirely when the toggle is off,
            per BR-07-1 ("the feature disappears from the trainer's UI"). A link
            that leads to a 403 is a broken feature, not a disabled one.

            DashboardNavigationTest holds this list against the router: every
            module's entry point must appear for the role that owns it.
        #}
        <nav aria-label="Main">
            <h2>Account</h2>
            <ul>
                <li><a href="{{ path('identity_account_profile_edit') }}">Your profile</a></li>
            </ul>

            {% if role.value == 'super_admin' %}
                <h2>Platform</h2>
                <ul>
                    <li><a href="{{ path('administration_dashboard') }}">Dashboard</a></li>
                    <li><a href="{{ path('administration_users_index') }}">Users</a></li>
                    <li><a href="{{ path('administration_trainers_index') }}">Trainers</a></li>
                    <li><a href="{{ path('administration_event_master_index') }}">Event Master Tool</a></li>
                    <li><a href="{{ path('administration_audit_log_index') }}">Audit Log</a></li>
                    <li><a href="{{ path('administration_stripe_dashboard_link') }}">Stripe Dashboard</a></li>
                </ul>

                <h2>Across trainers</h2>
                <ul>
                    <li><a href="{{ path('crm_super_admin_dashboard') }}">CRM Dashboard</a></li>
                    <li><a href="{{ path('crm_super_admin_players_index') }}">Players</a></li>
                    <li><a href="{{ path('content_super_admin_analytics') }}">Content Analytics</a></li>
                    <li><a href="{{ path('growth_super_admin_referral_rules') }}">Referral Rules</a></li>
                </ul>
            {% endif %}

            {% if role.value == 'trainer' %}
                <h2>Players</h2>
                <ul>
                    <li><a href="{{ path('crm_trainer_quick_view') }}">Quick View</a></li>
                    <li><a href="{{ path('crm_trainer_players_index') }}">Players</a></li>
                    <li><a href="{{ path('crm_trainer_labels_index') }}">Labels</a></li>
                </ul>

                <h2>Scheduling</h2>
                <ul>
                    <li><a href="{{ path('scheduling_trainer_event_index') }}">Events</a></li>
                    <li><a href="{{ path('identity_trainer_coaches_index') }}">Coaches</a></li>
                </ul>

                {% if features.lppp ?? true %}
                    <h2>Content</h2>
                    <ul>
                        <li><a href="{{ path('content_trainer_learn_index') }}">Learn Playlists</a></li>
                        <li><a href="{{ path('content_trainer_practice_index') }}">Practice Playlists</a></li>
                        <li><a href="{{ path('content_trainer_drills_index') }}">Drills</a></li>
                    </ul>
                {% endif %}

                <h2>Money</h2>
                <ul>
                    <li><a href="{{ path('billing_trainer_settings') }}">Billing &amp; Stripe</a></li>
                    <li><a href="{{ path('billing_trainer_pricing_edit') }}">Pricing</a></li>
                    <li><a href="{{ path('billing_trainer_earnings') }}">Earnings</a></li>
                </ul>

                {% if features.marketing ?? true %}
                    <h2>Marketing</h2>
                    <ul>
                        <li><a href="{{ path('growth_trainer_referrals_dashboard') }}">Referrals</a></li>
                        <li><a href="{{ path('growth_trainer_coupons_index') }}">Coupons</a></li>
                    </ul>
                {% endif %}

                <h2>Growing your roster</h2>
                <ul>
                    <li><a href="{{ path('identity_trainer_sharelinks_index') }}">ShareLinks</a></li>
                    {% if features.camps ?? true %}
                        <li><a href="{{ path('forms_trainer_index') }}">Camps &amp; Evaluations</a></li>
                    {% endif %}
                    <li><a href="{{ path('identity_trainer_branding_edit') }}">Branding</a></li>
                </ul>
            {% endif %}

            {% if role.value == 'coach' %}
                <h2>Coaching</h2>
                <ul>
                    <li><a href="{{ path('scheduling_coach_activities') }}">My Activities</a></li>
                    <li><a href="{{ path('crm_coach_players_index') }}">My Players</a></li>
                    <li><a href="{{ path('identity_coach_player_invite_index') }}">Invite a Player</a></li>
                    <li><a href="{{ path('identity_coach_availability_edit') }}">My Times</a></li>
                </ul>
            {% endif %}

            {% if role.value == 'player' %}
                <h2>Training</h2>
                <ul>
                    <li><a href="{{ path('scheduling_portal_calendar') }}">Training Calendar</a></li>
                    <li><a href="{{ path('scheduling_portal_reservations') }}">My Reservations</a></li>
                    <li><a href="{{ path('identity_portal_availability_edit') }}">My Times</a></li>
                </ul>

                {% if features.lppp ?? true %}
                    <h2>Content</h2>
                    <ul>
                        <li><a href="{{ path('content_portal_index') }}">Learn &amp; Practice</a></li>
                        <li><a href="{{ path('content_portal_progress') }}">My Progress</a></li>
                    </ul>
                {% endif %}

                <h2>Family</h2>
                <ul>
                    <li><a href="{{ path('identity_portal_family_index') }}">Family</a></li>
                    <li><a href="{{ path('identity_portal_approvals_index') }}">Approvals</a></li>
                </ul>

                <h2>Money</h2>
                <ul>
                    <li><a href="{{ path('billing_portal_tokens') }}">Tokens</a></li>
                    <li><a href="{{ path('billing_portal_transactions') }}">Transaction History</a></li>
                    {% if features.marketing ?? true %}
                        <li><a href="{{ path('growth_portal_referrals') }}">Refer a Friend</a></li>
                    {% endif %}
                </ul>
            {% endif %}
        </nav>

        <p>
            <a href="{{ path('identity_auth_logout') }}">Sign out</a>
        </p>
    </div>
{% endblock %}
