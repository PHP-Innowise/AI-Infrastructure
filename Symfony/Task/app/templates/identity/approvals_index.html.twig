{% extends 'base.html.twig' %}

{% block title %}Approvals — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <h1>Approvals</h1>

        {% if requests is empty %}
            <p>Nothing pending.</p>
        {% else %}
            <table>
                <thead><tr><th>Child</th><th>Type</th><th>Status</th><th>Requested</th><th></th></tr></thead>
                <tbody>
                {% for request in requests %}
                    <tr>
                        <td>{{ request.childPlayer.firstName }}</td>
                        <td>{{ request.actionType }}</td>
                        <td>{{ request.displayStatus(now) }}</td>
                        <td>{{ request.requestedAt|date('Y-m-d H:i') }}</td>
                        <td>
                            {% if request.displayStatus(now) == 'pending' %}
                                {# AC-02-23..26/33: an RSVP-related request needs Scheduling's own
                                   post-decision step (confirming/canceling the actual Rsvp row),
                                   so it routes to PortalReservationController's decide actions
                                   instead of ApprovalController's generic ones — see that
                                   controller's own docblock. #}
                                {% if request.actionType in ['rsvp', 'rsvp_cancellation'] %}
                                    <a href="{{ path('scheduling_portal_rsvp_approval_approve', {approval: request.id}) }}">Approve</a>
                                    ·
                                    <a href="{{ path('scheduling_portal_rsvp_approval_deny', {approval: request.id}) }}">Deny</a>
                                {% else %}
                                    <a href="{{ path('identity_portal_approval_approve', {approval: request.id}) }}">Approve</a>
                                    ·
                                    <a href="{{ path('identity_portal_approval_deny', {approval: request.id}) }}">Deny</a>
                                {% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
