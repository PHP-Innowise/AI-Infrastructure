{% extends 'base.html.twig' %}

{% block title %}{{ pillar == 'learn' ? 'Learn' : 'Practice' }} — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <h1>{{ pillar == 'learn' ? 'Learn' : 'Practice' }}</h1>
        <p>
            <a class="button button--primary" href="{{ path(pillar == 'learn' ? 'content_trainer_learn_create' : 'content_trainer_practice_create') }}">
                + Create {{ pillar == 'learn' ? 'Learn Playlist' : 'Practice Playlist' }}
            </a>
        </p>

        {% if playlists is empty %}
            <p>No playlists yet.</p>
        {% else %}
            <table>
                <thead><tr><th>Title</th><th>Visibility</th><th></th></tr></thead>
                <tbody>
                    {% for playlist in playlists %}
                        <tr>
                            <td><a href="{{ path('content_trainer_playlist_show', {playlist: playlist.id}) }}">{{ playlist.title }}</a></td>
                            <td>
                                {% if playlist.public %}<span class="badge badge--public">Public</span>{% else %}Private{% endif %}
                                {% if playlist.coachesOnly %}<span class="badge">Coaches Only</span>{% endif %}
                            </td>
                            <td></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
