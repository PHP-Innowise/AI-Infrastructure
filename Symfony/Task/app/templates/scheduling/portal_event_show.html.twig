{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <p class="skeleton-eyebrow">{{ event.eventType }}</p>
        <h1>{{ event.title }}</h1>
        <p>{{ event.startsAt|date('l, F j, Y \\a\\t g:i A', event.trainer.timezone) }} — {{ event.location }}</p>
        {% if event.description %}<p>{{ event.description }}</p>{% endif %}

        {% if event.free %}
            <p>Free</p>
        {% else %}
            <p>
                {% if event.usdPricingEnabled %}${{ (event.usdPriceMinorUnits / 100)|number_format(2) }}{% endif %}
                {% if event.usdPricingEnabled and event.tokenPricingEnabled %} OR {% endif %}
                {% if event.tokenPricingEnabled %}{{ event.tokenPrice }} token{{ event.tokenPrice > 1 ? 's' : '' }}{% endif %}
            </p>
            {# AC-05-8's first offer. Shown whenever the event takes tokens
               rather than only after a rejected attempt: the player who
               just read "You have 0 tokens, need 1" needs the way out on
               the page they were sent back to, and a player who can see the
               shortfall coming should not have to trigger it first. The
               criterion's second offer, "Pay with Card Instead", is the usd
               option in the payment-method choice below. #}
            {% if event.tokenPricingEnabled %}
                <p><a href="{{ path('billing_portal_tokens') }}">Buy More Tokens</a></p>
            {% endif %}
        {% endif %}

        {% if existingRsvp %}
            <p role="status">Already registered.</p>
        {% elseif isFull %}
            <p role="alert">
                {{ event.free ? 'Event Full - No spots available' : 'Event Full' }}.
                Check back later or contact the trainer.
            </p>
        {% elseif form %}
            {{ form_start(form) }}
                {{ form_widget(form) }}
            {{ form_end(form) }}
        {% endif %}
    </div>
{% endblock %}
