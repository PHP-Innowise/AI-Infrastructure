{% extends 'base.html.twig' %}

{% block title %}Players — PracticePerfect{% endblock %}

{% block body %}
    <div class="skeleton-card">
        <h1>Players</h1>
        <p>
            <a class="button button--primary" href="{{ path('crm_trainer_labels_index') }}">Manage Labels</a>
            ·
            <a href="{{ path('crm_trainer_quick_view') }}">Quick View Dashboard</a>
        </p>

        {# AC-03-8/9/10: tool-specific search, partial-match, live via query string. #}
        <form method="get" action="{{ path('crm_trainer_players_index') }}" role="search">
            <input type="search" name="q" value="{{ criteria.query }}" placeholder="Search players, parents, team...">
            {% if criteria.query %}
                <a href="{{ path('crm_trainer_players_index') }}">Clear (X)</a>
            {% endif %}
            <button type="submit">Search</button>
        </form>

        {# AC-03-22..26: filter panel. #}
        <form method="get" action="{{ path('crm_trainer_players_index') }}">
            <input type="hidden" name="q" value="{{ criteria.query }}">

            {# The same four the profile form offers — read from SkillLevel
               rather than restated here, which is how the two drifted apart
               in the first place. #}
            <label>Skill Level
                <select name="skillLevel">
                    <option value="">Any</option>
                    {% for level in constant('App\\Identity\\Entity\\SkillLevel::ALL') %}
                        <option value="{{ level }}" {{ criteria.skillLevel == level ? 'selected' }}>{{ level }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>Age min <input type="number" name="minAge" value="{{ criteria.minAge }}"></label>
            <label>Age max <input type="number" name="maxAge" value="{{ criteria.maxAge }}"></label>

            <label>Gender
                <select name="gender">
                    <option value="">All</option>
                    <option value="male" {{ criteria.gender == 'male' ? 'selected' }}>Male</option>
                    <option value="female" {{ criteria.gender == 'female' ? 'selected' }}>Female</option>
                    <option value="other" {{ criteria.gender == 'other' ? 'selected' }}>Other</option>
                </select>
            </label>

            <label>Team/School/Club <input type="text" name="teamSchoolClub" value="{{ criteria.teamSchoolClub }}"></label>

            <fieldset>
                <legend>Labels</legend>
                {% for label in labels %}
                    <label><input type="checkbox" name="labels[]" value="{{ label.id }}" {{ label.id in criteria.labelIds ? 'checked' }}> {{ label.name }}</label>
                {% endfor %}
            </fieldset>

            <fieldset>
                <legend>Flags</legend>
                {% for type, def in flagDefinitions %}
                    <label><input type="checkbox" name="flags[]" value="{{ type }}" {{ type in criteria.flagTypes ? 'checked' }}> {{ def }}</label>
                {% endfor %}
            </fieldset>

            <label>Attended more than <input type="number" name="attendedMoreThan" value="{{ criteria.attendedMoreThan }}"> events</label>
            <label>Attended within last <input type="number" name="attendedInLastDays" value="{{ criteria.attendedInLastDays }}"> days</label>
            <label>Attendance rate greater than <input type="number" name="attendanceRateGreaterThan" min="0" max="100" value="{{ criteria.attendanceRateGreaterThan }}">%</label>
            <label>No-shows greater than <input type="number" name="noShowsGreaterThan" value="{{ criteria.noShowsGreaterThan }}"></label>

            <label>Registered from <input type="date" name="registeredFrom" value="{{ criteria.registeredFrom ? criteria.registeredFrom|date('Y-m-d') }}"></label>
            <label>Registered to <input type="date" name="registeredTo" value="{{ criteria.registeredTo ? criteria.registeredTo|date('Y-m-d') }}"></label>

            <label>Last Activity
                <select name="lastActivityBand">
                    <option value="">Any</option>
                    <option value="active" {{ criteria.lastActivityBand == 'active' ? 'selected' }}>Active (within 30 days)</option>
                    <option value="inactive" {{ criteria.lastActivityBand == 'inactive' ? 'selected' }}>Inactive (30-90 days)</option>
                    <option value="churned" {{ criteria.lastActivityBand == 'churned' ? 'selected' }}>Churned (&gt;90 days)</option>
                </select>
            </label>

            <label>Sort by
                <select name="sort">
                    <option value="name_asc" {{ criteria.sort == 'name_asc' ? 'selected' }}>Name (A-Z)</option>
                    <option value="name_desc" {{ criteria.sort == 'name_desc' ? 'selected' }}>Name (Z-A)</option>
                    <option value="last_activity" {{ criteria.sort == 'last_activity' ? 'selected' }}>Last Activity</option>
                    <option value="attendance_rate" {{ criteria.sort == 'attendance_rate' ? 'selected' }}>Attendance Rate</option>
                </select>
            </label>

            <button type="submit">Apply filters</button>
            <a href="{{ path('crm_trainer_players_index') }}">Clear all filters</a>
        </form>

        {# AC-03-25: match count. #}
        <p class="skeleton-caption">{{ total }} player{{ total == 1 ? '' : 's' }} match your filters</p>

        {% if items is empty %}
            {# AC-03-9 (search) and BR-03-15/AC-03-26 (filters) are two
               distinct empty states — a present search query gets its own
               copy even if other filters are also active. #}
            {% if criteria.query %}
                <p>No players found. Try different search terms.</p>
            {% else %}
                <p>No players match your filters. Try adjusting criteria.</p>
            {% endif %}
        {% else %}
            <table>
                <thead>
                    <tr><th>Name</th><th>Age</th><th>Gender</th><th>Skill</th><th>Attendance Rate</th><th>Last Activity</th></tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td><a href="{{ path('crm_trainer_player_show', {membership: item.membershipId}) }}">{{ item.name }}</a></td>
                            <td>{{ item.age }}</td>
                            <td>{{ item.gender }}</td>
                            <td>{{ item.skillLevel }}</td>
                            <td>{{ item.attendanceRate }}%</td>
                            <td>{{ item.lastActivityAt|date('Y-m-d') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
