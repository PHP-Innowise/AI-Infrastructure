<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}PracticePerfect{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {#
            Runtime branding layer. These five properties are the ONLY
            runtime-overridable custom properties in the system: a trainer's
            brand ships without a deploy because it is a value read at request
            time, never a build input.

            See specs/architect-architecture.md § "White-label branding as a
            runtime value" and specs/frontend-design-spec.md § "Design tokens".

            The values below are the platform defaults. Epic-01 replaces this
            block's contents with BrandingProvider output resolved for the
            active trainer (and adds the CSP nonce, once the security headers
            land). Nothing else may be emitted inline, and nothing in
            app.css may reference a trainer's raw hex except through these
            five names.
        #}
        {% block branding %}
        <style>
            :root {
                --brand-primary: #00B300;
                --brand-primary-soft: #33C233;
                --brand-primary-deep: #008F00;
                --brand-primary-rgb: 0, 179, 0;
                --brand-on-primary: #0D0D0D;
            }
        </style>
        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to main content</a>

        {#
            AC-01-34: a sticky, color-coded banner on every page for the
            duration of an impersonation session. Driven entirely from
            IS_IMPERSONATOR (Symfony's own switch_user marker role) rather
            than a bespoke flag, so it can never drift out of sync with the
            actual security token — specs/api-designer-spec.md
            "Impersonation — a whole session, one identity swap".
        #}
        {% if is_granted('IS_IMPERSONATOR') %}
            <div class="impersonation-banner" role="alert">
                <span>Viewing as {{ app.user.email }}</span>
                <form method="post" action="{{ path('impersonation_exit') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('impersonation-exit') }}">
                    <button type="submit">Exit Impersonation</button>
                </form>
            </div>
        {% endif %}

        {% block header %}{% endblock %}

        <main id="main" tabindex="-1">
            {# AC-01-49 and every other "...with a confirmation message"
               criterion: flash messages set via addFlash() render here, once,
               for every page in the application. #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <p role="status" class="flash flash--{{ type }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block footer %}{% endblock %}
    </body>
</html>
