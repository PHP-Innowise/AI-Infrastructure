{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://php-innowise.example/schemas/qa/tc-ai-case.schema.json",
  "title": "TC-AI deterministic and native case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "test_case_id",
        "title",
        "classification",
        "commands",
        "required_test_patterns",
        "native_requirement",
        "blocker"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^RUN-20260803-[0-9]{3}$"
        },
        "test_case_id": {
          "type": "string",
          "pattern": "^TC-AI-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "deterministic",
            "hybrid",
            "native"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "argv",
              "cwd"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "requires_executable": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._+-]+$"
              }
            }
          }
        },
        "required_test_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "glob",
              "regex"
            ],
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "regex": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "native_requirement": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
