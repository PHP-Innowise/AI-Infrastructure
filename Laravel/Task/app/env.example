# PracticePerfect environment template, Laravel edition.
#
#   make setup      (copies this file to .env, which is git-ignored)
#
# NOTE ON THE FILENAME: the brief asks for `.env.example`. This repository's
# own .claude/settings.json denies Write(.env.*), which matches that name, so
# the template is committed as `env.example`. Relax that deny rule if you want
# the conventional dot-prefixed name.
#
# Never commit real credentials. The database passwords below are throwaway
# values for the local Compose stack only. Stripe keys are deliberately blank.

APP_NAME=PracticePerfect
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8091
# Generated by `make install` (php artisan key:generate). Never commit a real one.
APP_KEY=

COMPOSE_PROJECT_NAME=practiceperfect-laravel

# --- Host user -------------------------------------------------------------
UID=1000
GID=1000

# --- Host port bindings ----------------------------------------------------
# Deliberately unusual: 8080/8025/5432 are commonly taken by another stack.
HTTP_PORT=8091
MAIL_UI_PORT=8126
DB_PORT_HOST=15434

# --- PostgreSQL roles ------------------------------------------------------
# Three roles, because Row-Level Security is load-bearing:
#   owner    — DDL and migrations only, never the running application
#   app      — the running application; RLS applies to it
#   crossing — read-only, BYPASSRLS, cross-tenant projections only
POSTGRES_DB=practiceperfect
POSTGRES_OWNER_USER=pp_owner
POSTGRES_OWNER_PASSWORD=owner_dev_only
APP_DB_USER=pp_app
APP_DB_PASSWORD=app_dev_only
CROSSING_DB_USER=pp_crossing
CROSSING_DB_PASSWORD=crossing_dev_only

# NOTE: DB_CONNECTION, DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD, the
# owner/crossing credentials, MAIL_*, QUEUE_CONNECTION, CACHE_STORE and
# SESSION_DRIVER are deliberately NOT set here. compose.yaml composes them from
# the role credentials above, so "which role does the application connect as" is
# decided in exactly one place. Compose `environment` beats `env_file`, so
# setting them here would have no effect.

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Stripe ----------------------------------------------------------------
# Test keys only. Leave blank until Epic-05. Never commit a real key.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
