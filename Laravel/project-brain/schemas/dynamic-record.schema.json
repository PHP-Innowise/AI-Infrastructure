{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/project-brain/dynamic-record.schema.json",
  "title": "Project Brain dynamic record frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "type", "external_id", "title", "status",
    "revision", "owner", "authorized_owners", "privacy", "authority",
    "confidence", "created_at", "updated_at", "transitions",
    "source_fingerprints", "conflicts", "supersedes", "superseded_by",
    "goal", "progress", "next_steps", "files", "sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "type": {"enum": ["task", "finding", "bug", "incident", "decision", "event"]},
    "external_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "blocked", "verifying", "completed", "cancelled", "open", "investigating", "resolved", "superseded", "reported", "triaged", "fixing", "contained", "recovering", "closed", "proposed", "accepted", "rejected", "recorded"]},
    "revision": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "minLength": 1},
    "authorized_owners": {"$ref": "#/$defs/stringList"},
    "privacy": {"enum": ["public", "team", "restricted", "private"]},
    "authority": {"enum": ["inferred", "observed", "verified"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "actor", "reason"],
        "properties": {
          "from": {"type": ["string", "null"]},
          "to": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "conflicts": {"$ref": "#/$defs/stringList"},
    "supersedes": {"$ref": "#/$defs/stringList"},
    "superseded_by": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "progress": {"type": "string"},
    "next_steps": {"$ref": "#/$defs/stringList"},
    "files": {"$ref": "#/$defs/stringList"},
    "sources": {"$ref": "#/$defs/stringList"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "task"}}}, "then": {"properties": {"status": {"enum": ["active", "blocked", "verifying", "completed", "cancelled"]}}}},
    {"if": {"properties": {"type": {"const": "finding"}}}, "then": {"properties": {"status": {"enum": ["open", "investigating", "resolved", "superseded"]}}}},
    {"if": {"properties": {"type": {"const": "bug"}}}, "then": {"properties": {"status": {"enum": ["reported", "triaged", "fixing", "verifying", "resolved", "cancelled"]}}}},
    {"if": {"properties": {"type": {"const": "incident"}}}, "then": {"properties": {"status": {"enum": ["open", "contained", "recovering", "resolved", "closed", "cancelled"]}}}},
    {"if": {"properties": {"type": {"const": "decision"}}}, "then": {"properties": {"status": {"enum": ["proposed", "accepted", "rejected", "superseded"]}}}},
    {"if": {"properties": {"type": {"const": "event"}}}, "then": {"properties": {"status": {"enum": ["recorded", "superseded"]}}}}
  ],
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
