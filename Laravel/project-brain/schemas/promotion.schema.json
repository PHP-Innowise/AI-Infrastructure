{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "status", "revision", "proposer", "reviewer",
    "review_mode", "reviewed_at", "created_at", "updated_at", "source_records",
    "title", "content", "destination_memory_id", "destination_revision",
    "conflicts", "outcome"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["proposed", "reviewed", "rejected", "applied"]},
    "revision": {"type": "integer", "minimum": 1},
    "proposer": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"]},
    "review_mode": {"enum": ["human", "automatic"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "revision"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "type": {"enum": ["task", "finding", "bug", "incident", "decision", "event"]},
          "path": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_verifications": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "phase", "original_updated_at", "proposal_sha256", "destination", "predecessor", "sources", "sha256"],
      "properties": {
        "profile": {"const": "promotion-publication-v1"},
        "phase": {"enum": ["publish", "rollback"]},
        "original_updated_at": {"type": "string", "format": "date-time"},
        "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "destination": {
          "type": "object", "additionalProperties": false, "required": ["path", "after"],
          "properties": {"path": {"type": "string"}, "after": {"$ref": "#/$defs/publication_image"}}
        },
        "predecessor": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["path", "before", "after"],
          "properties": {"path": {"type": "string"}, "before": {"$ref": "#/$defs/publication_image"}, "after": {"$ref": "#/$defs/publication_image"}}
        },
        "sources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
          "properties": {"id": {"type": "string", "format": "uuid"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "destination_memory_id": {"type": ["string", "null"]},
    "destination_revision": {"type": ["integer", "null"], "minimum": 1},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outcome": {"type": ["string", "null"]}
  },
  "$defs": {
    "publication_image": {"type": "object", "additionalProperties": false, "required": ["data", "sha256"],
      "properties": {"data": {"type": "string", "maxLength": 1398104}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
