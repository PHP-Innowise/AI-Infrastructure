{
  "env": {
    "APP_ENV": "local",
    "FORCE_COLOR": "1",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Grep(**)",
      "Bash(php:*)",
      "Bash(php artisan:*)",
      "Bash(composer:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/psalm:*)",
      "Bash(vendor/bin/rector:*)",
      "Bash(vendor/bin/phpbench:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(memory-bank/bin/infra-engine memory:*)",
      "Bash(memory-bank/bin/infra-engine.exe memory:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(make:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:php.net)",
      "WebFetch(domain:www.php.net)",
      "WebFetch(domain:laravel.com)",
      "WebFetch(domain:www.laravel.com)",
      "WebFetch(domain:laravel-news.com)",
      "WebFetch(domain:livewire.laravel.com)",
      "WebFetch(domain:inertiajs.com)",
      "WebFetch(domain:spatie.be)",
      "WebFetch(domain:getcomposer.org)",
      "WebFetch(domain:packagist.org)",
      "WebFetch(domain:pestphp.com)",
      "WebFetch(domain:phpunit.de)",
      "WebFetch(domain:phpstan.org)",
      "WebFetch(domain:psalm.dev)"
    ],
    "deny": [
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude local-context --root .",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude context-continuity --root .",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude working-memory-read --root .",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude context-continuity --root .",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude working-memory-write --root .",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude context-continuity --root .",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude subagent-gate --root .",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude file-naming-validator --root .",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude bash-validator --root .",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude loop-detection --root .",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude subagent-dispatch --root .",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude subagent-dispatch --root .",
            "timeout": 8
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook claude notification --root .",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
