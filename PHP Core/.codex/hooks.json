{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex local-context --root ."
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex context-continuity --root .",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex working-memory-read --root .",
            "additionalContextLimit": 4000
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex context-continuity --root ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex working-memory-write --root ."
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex context-continuity --root ."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex bash-validator --root ."
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex file-naming-validator --root ."
          },
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex subagent-gate --root ."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memory-bank/bin/infra-engine hook codex loop-detection --root ."
          }
        ]
      }
    ]
  }
}
